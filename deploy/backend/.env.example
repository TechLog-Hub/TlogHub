TLOG_API_IMAGE=ghcr.io/techlog-hub/tloghub/api:develop
TLOG_API_ENV_FILE=.env.example
TLOG_API_CONTAINER_NAME=tlog-api
TLOG_API_HOST_PORT=8080

SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres.example.internal:5432/techlog_hub
SPRING_DATASOURCE_USERNAME=techlog
SPRING_DATASOURCE_PASSWORD=change-me

TECHLOG_BATCH_SCHEDULE_ENABLED=false
TECHLOG_BATCH_COLLECT_CRON=0 */30 * * * *
TECHLOG_BATCH_MAX_ENTRIES_PER_SOURCE=100
TECHLOG_BATCH_USER_AGENT=TechlogHubBot/0.1
TECHLOG_SUBSCRIPTION_EXPOSE_DEV_TOKENS=false
